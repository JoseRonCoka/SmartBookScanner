<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SubmitBook">

    <TextView
        android:id="@+id/submitBookTitle"
        android:layout_width="355dp"
        android:layout_height="65dp"
        android:layout_marginTop="60dp"
        android:text="Please enter the Book's details:"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="364dp"
        android:layout_height="365dp"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submitBookTitle">

        <TextView
            android:id="@+id/isbnInputInstructions"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:text="Enter the ISBN manually or by scanning the barcode." />

        <EditText
            android:id="@+id/bookIsbnInput"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:ems="10"
            android:hint="ISBN"
            android:inputType="number" />

        <Button
            android:id="@+id/scanButtonSubmitBook"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Scan" />

        <EditText
            android:id="@+id/bookTitleInput"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:ems="10"
            android:hint="Book Title"
            android:inputType="text" />

        <EditText
            android:id="@+id/bookAuthorInput"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:ems="10"
            android:hint="Author"
            android:inputType="text" />

        <EditText
            android:id="@+id/bookPriceInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:ems="10"
            android:hint="Price in $"
            android:inputType="number" />

        <EditText
            android:id="@+id/availableCopiesInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:ems="10"
            android:hint="Available Copies"
            android:inputType="number" />

    </LinearLayout>

    <Button
        android:id="@+id/submitBookButton"
        android:layout_width="193dp"
        android:layout_height="67dp"
        android:layout_gravity="center"
        android:layout_marginTop="56dp"
        android:text="Submit Book"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>