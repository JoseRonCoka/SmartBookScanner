<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".displayOrder">

    <TextView
        android:id="@+id/idTextView2"
        android:layout_width="360dp"
        android:layout_height="52dp"
        android:layout_marginTop="64dp"
        android:text="Order: "
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/bookDetailsTV2"
        android:layout_width="325dp"
        android:layout_height="123dp"
        android:layout_marginTop="72dp"
        android:text="Book Details:"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.511"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderDetailsTextView2" />

    <TextView
        android:id="@+id/orderDetailsTextView2"
        android:layout_width="323dp"
        android:layout_height="132dp"
        android:layout_marginTop="84dp"
        android:text="Order Details:"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/idTextView2" />

</androidx.constraintlayout.widget.ConstraintLayout>